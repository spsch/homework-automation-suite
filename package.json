{
  "name": "homework-automation-suite",
  "version": "1.0.0",
  "description": "Playwright test automation suite (smoke + e2e) for the PrestaShop demo storefront at prestashop.tesena.com",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=*-smoke",
    "test:e2e": "playwright test --project=*-e2e",
    "test:chromium": "playwright test --project=chromium-*",
    "test:headed": "playwright test --project=chromium-* --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spsch/homework-automation-suite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/spsch/homework-automation-suite/issues"
  },
  "homepage": "https://github.com/spsch/homework-automation-suite#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}
